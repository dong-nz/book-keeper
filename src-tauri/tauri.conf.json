{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Book Keeper",
  "version": "0.0.10",
  "identifier": "com.bookkeeper.app",
  "build": {
    "beforeDevCommand": "pnpm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:vite",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Book Keeper",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost bookkeeper-epub: http://bookkeeper-epub.localhost; style-src 'self' 'unsafe-inline' bookkeeper-epub: http://bookkeeper-epub.localhost; font-src 'self' bookkeeper-epub: http://bookkeeper-epub.localhost; connect-src 'self' bookkeeper-epub: http://bookkeeper-epub.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**",
          "$APPDATA/reader/**",
          "$APPDATA/parallel/**/covers/**",
          "$APPDATA/parallel/**/reader/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dong-nz/book-keeper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MEQ2REQwRjFBNTRFMzUKUldRMVRxWHgwRzBONlZIdWhEdXNha3MrOVFvZjdlbi9ab1NhS0wxOURQL1V1UVRxTit4WWVKQVMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*pdfium*"],
    "windows": {
      "nsis": {},
      "wix": {}
    }
  }
}
